+        HwStage::Gs => gs_io(payload, start, stage_data).unwrap_or(StageIo::None),
+        HwStage::Ms => ms_io(stage_data, u32_at(record, RECORD_LDS)?)?,
+        _ => StageIo::None,
+    };
+    Ok(NativeProgram {
+        stage,
+        wave64: u32_at(record, RECORD_FLAGS)? & FLAG_WAVE32 == 0,
+        vgprs,
+        layout,
+        used,
+        io,
+        code: code.to_vec(),
