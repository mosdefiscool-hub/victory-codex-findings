+    fn write_mark(pixel: bool, threads: Option<[u32; 3]>, heap: bool) -> Vec<u8> {
+        let mut shader = Shader::new(pixel);
+        shader.threads = threads;
+        let block = shader.entry;
+        let zero = shader.m.i32(0);
+        let handle = if heap {
+            shader.heap_handle(block, zero, false, false, (11 | 0x1000, 0))
+        } else {
+            shader.view_writes_handle()
+        };
+        let or = shader.m.i32(2);
+        let one = shader.m.i32(1);
+        let unused = shader.m.undef(shader.t.i32);
+        shader.op(
+            block,
+            "atomicBinOp.i32",
+            Attr::NoUnwind,
+            shader.t.i32,
+            78,
+            &[handle, or, zero, unused, unused, one],
+        );
+        shader.m.terminate(block, Term::Ret);
+        shader.finish()
+    }
+
+    #[test]
