+        let mut code = vec![vop1(0x00f, 0, src)];
+        code.extend(high);
+        let shader = build_valu_cs(&code);
+        run_cases(&shader, &[[0; 4]], |backend, _, _, got| {
+            assert_eq!(got, want.to_bits(), "{backend}: source {src}");
+        });
+    }
+
+    let mut code = vop3(0x18f, 0, vgpr(1), 0, 0);
+    code[0] |= (1 << 8) | (1 << 15); // abs, then clamp the result
+    code[1] |= 1 << 27; // multiply the converted result by two
+    let shader = build_valu_cs(&code);
+    run_cases(&shader, &[[0, 0xbfe8_0000, 0, 0]], |backend, _, _, got| {
+        assert_eq!(got, 1.0f32.to_bits(), "{backend}: clamp(abs(-0.75) * 2)");
+    });
+}
