+#[test]
+fn cvt_f32_f64_rounds_register_pairs() {
+    let shader = build_valu_cs(&[vop1(0x00f, 0, vgpr(1))]);
+    let values = [
+        0.0f64,
+        -0.0,
+        1.25,
+        -65536.5,
+        f64::from_bits(0x3ff0_0000_1000_0000), // halfway, even lower endpoint
+        f64::from_bits(0x3ff0_0000_3000_0000), // halfway, even upper endpoint
+        f64::from_bits(0x3ff0_0000_1000_0001), // just above halfway
+        f64::from(f32::MIN_POSITIVE) * 0.5,
+        f64::from(f32::MAX),
+        f64::MAX,
+        f64::NEG_INFINITY,
+        f64::NAN,
+    ];
+    let inputs: Vec<_> = values
+        .iter()
+        .map(|input| {
+            let bits = input.to_bits();
+            [bits as u32, (bits >> 32) as u32, 0, 0]
+        })
+        .collect();
+    run_cases(&shader, &inputs, |backend, i, _, got| {
+        let input = values[i];
+        if input.is_nan() {
+            assert!(f32::from_bits(got).is_nan(), "{backend}: {got:#010x}");
+        } else {
+            assert_eq!(got, (input as f32).to_bits(), "{backend}: {input}");
+        }
+    });
+}
