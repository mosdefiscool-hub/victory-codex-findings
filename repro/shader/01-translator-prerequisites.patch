+    #[cfg(windows)]
+    fn quad_sample_program(
+        threads: [u32; 3],
+        bias: Option<f32>,
+        offset: bool,
+    ) -> crate::NativeProgram {
+        let mut native = implicit_sample(true);
+        let vop2 = |opcode: u32, dst: u32, src0: u32, src1: u32| {
+            opcode << 25 | dst << 17 | src1 << 9 | src0
+        };
+        let vop1 = |opcode: u32, dst: u32, src: u32| 0x7E00_0000 | dst << 17 | opcode << 9 | src;
+        let mut words: Vec<u32> = native.code[..10 * 4]
+            .chunks_exact(4)
+            .map(|w| u32::from_le_bytes(w.try_into().unwrap()))
+            .collect();
+        words.extend([
+            0xBF8C_C07F, // s_waitcnt lgkmcnt(0)
+            0x9314_8203, // s_mul_i32 s20, s3, 2 (group Y)
+            0x8014_0214, // s_add_u32 s20, s20, s2 (group X)
+            0x9315_FF14,
+            256,                                                 // s_mul_i32 s21, s20, 256
+            vop2(0x1A, 5, 128 + threads[0].trailing_zeros(), 1), // v5 = group width * thread Y
+            vop2(0x25, 5, 256, 5),                               // v5 += thread X
+            vop2(0x1A, 16, 130, 5),                              // v16 = lane's byte offset
+            vop2(0x25, 16, 21, 16),                              // v16 += group's byte offset
+            0xD760_002C,
+            0x0001_5100,           // v_readlane_b32 s44, v0, 40
+            vop2(0x25, 6, 44, 5),  // v6 = t + X of console lane 40
+            vop2(0x16, 6, 130, 6), // v6 >>= 2
+            vop2(0x25, 6, 20, 6),  // v6 += group index
+            vop2(0x1B, 6, 131, 6), // v6 &= 3 (mip)
+            vop2(0x16, 7, 129, 5), // v7 = t >> 1
