+        // The guest wave enters when its VCC has any set bit, but EXEC is full.
+        let vcc_branch = [CMP_0, 0xBF86_0002, READ_FIRST, VECTOR_USE, END];
+        assert!(!check(&vcc_branch, [256, 1, 1]));
