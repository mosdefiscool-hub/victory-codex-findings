+/// Prove a straight-line path through a full-wave compute group. Track one
+/// bit of each scalar (bit zero) and one value of each vector (lane zero is
+/// zero). An EXECZ guard cannot skip its body when that lane is active.
+/// Reject other control flow so no predecessor can invalidate these facts.
+fn lane_zero_fallthroughs(code: &[u8], vgprs: u16) -> Vec<usize> {
+    use crate::gfx10::{Fields, Operand};
+    use crate::ir::{self, Exit, Reg, EXEC};
+    use std::collections::HashSet;
+
+    let Ok(p) = ir::build(code, true, vgprs) else { return Vec::new() };
+    let exec = Reg::S(EXEC);
+    let mut known = HashSet::from([exec]);
+    let mut branches = Vec::new();
+    for (b, block) in p.blocks.iter().enumerate() {
+        match block.exit {
+            Exit::Jump(to) if to == b + 1 => {}
+            Exit::Branch { taken, not_taken }
+                if not_taken == b + 1 && taken > b
+                    && block.insts.last().is_some_and(|i| i.name() == "s_cbranch_execz") => {}
+            Exit::End if b + 1 == p.blocks.len() => {}
+            _ => return Vec::new(),
+        }
+        for i in &block.insts {
+            if i.name() == "s_cbranch_execz" {
+                if !known.contains(&exec) {
+                    return Vec::new();
+                }
+                branches.push(i.machine.offset);
+            }
+            let vector_zero = |op: &Operand| match *op {
+                Operand::Const(128) => true,
+                Operand::Vector { reg, dwords: 1 } => known.contains(&Reg::V(reg)),
+                _ => false,
+            };
+            let mut result = None;
+            let mut keeps_lane = false;
+            match &i.fields {
+                Fields::Valu(v) if known.contains(&exec) && v.dpp.is_none() && v.sdwa.is_none()
+                    && v.opsel == 0 && v.opsel_hi == 0 && v.neg == 0 && v.abs == 0
+                    && !v.clamp && v.omod == 0 => {
+                    match (i.name(), v.dst, v.src.as_slice()) {
+                        ("v_mbcnt_lo_u32_b32" | "v_mbcnt_hi_u32_b32",
+                            Some(Operand::Vector { reg, dwords: 1 }), [_, add]) if vector_zero(add) => {
+                            result = Some(Reg::V(reg));
+                        }
+                        ("v_cmp_eq_u32", Some(Operand::Scalar { code, .. }), [a, b])
+                            if vector_zero(a) && vector_zero(b) => result = Some(Reg::S(code)),
+                        _ => {}
+                    }
+                }
+                Fields::Sop { dst: Some(Operand::Scalar { code, .. }), src, .. } => {
+                    if let [Operand::Scalar { code: source, .. }] = src.as_slice() {
+                        let set = known.contains(&Reg::S(*source));
+                        match i.name() {
+                            "s_mov_b64" if set => result = Some(Reg::S(*code)),
+                            "s_and_saveexec_b64" if *code <= 104 && known.contains(&exec) => {
+                                result = Some(Reg::S(*code));
+                                keeps_lane = set;
+                            }
+                            _ => {}
+                        }
+                    }
+                }
+                _ => {}
+            }
+            for (reg, _) in &i.writes {
+                known.remove(reg);
+            }
+            known.extend(result.filter(|&reg| i.write(reg).is_some()));
+            if keeps_lane {
+                known.insert(exec);
+            }
+        }
     }
+    branches
 }
 
