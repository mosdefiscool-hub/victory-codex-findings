+//! Prove that a per-lane compute instruction can run on only one thread of
+//! the group. A compare of the original X thread ID identifies that thread
+//! in a one-dimensional group, including across the two halves of a wave.
+
+use std::collections::HashSet;
+
+use crate::gfx10::{Fields, Operand};
+use crate::ir::{EXEC, Inst, Program, Reg, Value};
+use crate::native::{NativeProgram, StageIo};
+use crate::resource::{Site, inline};
+use crate::structure::{Atom, Bool, Structured};
+
+fn thread_id(p: &Program, native: &NativeProgram) -> Option<(Value, u32)> {
+    let StageIo::Cs(cs) = native.io else {
+        return None;
+    };
+    let [threads, 1, 1] = cs.threads else {
+        return None;
+    };
+    let &(_, id) = p.inputs.iter().find(|&&(reg, _)| reg == Reg::V(0))?;
+    Some((id, threads))
+}
+
+fn compared_thread(compare: &Inst, id: Value, threads: u32) -> Option<u32> {
+    let Fields::Valu(fields) = &compare.fields else {
+        return None;
+    };
+    if compare.name() != "v_cmp_eq_u32"
+        || fields.dpp.is_some()
+        || fields.sdwa.is_some()
+        || fields.opsel != 0
+        || fields.neg != 0
+        || fields.abs != 0
+    {
+        return None;
+    }
+    let (code, reg) = match fields.src.as_slice() {
+        [Operand::Const(code), Operand::Vector { reg, dwords: 1 }]
+        | [Operand::Vector { reg, dwords: 1 }, Operand::Const(code)] => (*code, *reg),
+        _ => return None,
+    };
+    if compare.read(Reg::V(reg)) != Some(id) {
+        return None;
+    }
+    inline(code).filter(|&n| n < threads)
+}
+
+fn thread_selected_by(
+    p: &Program,
+    st: &Structured,
+    native: &NativeProgram,
+    facts: &[(Bool, bool)],
+) -> Option<u32> {
+    let (id, threads) = thread_id(p, native)?;
+    facts
+        .iter()
+        .flat_map(|&(condition, _)| st.bools.support(condition))
+        .find_map(|atom| {
+            let Atom::Lane(value) = atom else {
+                return None;
+            };
+            let compare = p
+                .blocks
+                .iter()
+                .flat_map(|b| &b.insts)
+                .find(|i| i.writes.iter().any(|&(_, v)| v == value))?;
+            let thread = compared_thread(compare, id, threads)?;
+            (st.bools.decides(facts, atom) == Some(true)).then_some(thread)
+        })
+}
+
+/// Both dwords of the guest EXEC read come directly from an intersection
+/// with the same singleton comparison. Check the machine SSA here because
+/// per-lane structure may already have simplified masks at CFG joins using
+/// the lanes that took each edge.
+fn guest_exec_thread(p: &Program, native: &NativeProgram, read: &Inst) -> Option<u32> {
+    let (id, threads) = thread_id(p, native)?;
+    let instructions = || p.blocks.iter().flat_map(|b| &b.insts);
+    let exec = [read.read(Reg::S(EXEC))?, read.read(Reg::S(EXEC + 1))?];
+    let and = instructions().find(|inst| {
+        matches!(inst.name(), "s_and_saveexec_b64" | "s_and_b64")
+            && inst.write(Reg::S(EXEC)) == Some(exec[0])
+            && inst.write(Reg::S(EXEC + 1)) == Some(exec[1])
+    })?;
+    let Fields::Sop { src, .. } = &and.fields else {
+        return None;
+    };
+    src.iter().find_map(|operand| {
+        let Operand::Scalar { code, dwords: 2 } = *operand else {
+            return None;
+        };
+        let low = and.read(Reg::S(code))?;
+        let high = and.read(Reg::S(code + 1))?;
+        let compare = instructions().find(|inst| {
+            inst.write(Reg::S(code)) == Some(low) && inst.write(Reg::S(code + 1)) == Some(high)
+        })?;
+        compared_thread(compare, id, threads)
+    })
+}
+
+/// The absolute ID of the only thread that can reach a vector instruction
+/// with its EXEC bit set in the per-lane form.
+pub(super) fn executing_thread(
+    p: &Program,
+    st: &Structured,
+    native: &NativeProgram,
+    (b, i): Site,
+) -> Option<u32> {
+    let exec = st.execs[b][i]?;
+    thread_selected_by(p, st, native, &[(st.reach[b], true), (exec, true)])
+}
+
+/// The read selects its own lane and every observable use takes place in
+/// that same thread. Follow scalar phis because a read in a loop can reach
+/// a later iteration through a phi. An unguarded scalar use could affect
+/// the rest of the logical wave even while that wave's EXEC is sparse.
+pub(super) fn first_lane_is_local(
+    p: &Program,
+    st: &Structured,
+    native: &NativeProgram,
+    (b, i): Site,
+) -> bool {
+    let inst = &p.blocks[b].insts[i];
+    let Some(exec) = st.execs[b][i] else {
+        return false;
+    };
+    let [(Reg::S(0..=105), value)] = inst.writes.as_slice() else {
+        return false;
+    };
+    let Fields::Valu(fields) = &inst.fields else {
+        return false;
+    };
+    if inst.name() != "v_readfirstlane_b32"
+        || !matches!(fields.src.as_slice(), [Operand::Vector { dwords: 1, .. }])
+        || fields.dpp.is_some()
+        || fields.sdwa.is_some()
+    {
+        return false;
+    }
+
+    // EXEC alone limits the guest's source lane. The host also needs that
+    // lane to be the only visitor and to have its EXEC bit set on arrival.
+    let reach = st.reach[b];
+    let Some(thread) = guest_exec_thread(p, native, inst) else {
+        return false;
+    };
+    if thread_selected_by(p, st, native, &[(reach, true)]) != Some(thread)
+        || st.bools.meet(&[(reach, true), (exec, false)])
+    {
+        return false;
+    }
+
+    let mut pending = vec![*value];
+    let mut seen = HashSet::<Value>::new();
+    while let Some(value) = pending.pop() {
+        if !seen.insert(value) {
+            continue;
+        }
+        for (b, block) in p.blocks.iter().enumerate() {
+            for phi in &block.phis {
+                if phi.args.contains(&value) {
+                    pending.push(phi.value);
+                }
+            }
+            for (i, inst) in block.insts.iter().enumerate() {
+                if !inst.reads.iter().any(|&(_, v)| v == value) {
+                    continue;
+                }
+                let plain_vector_use = matches!(&inst.fields, Fields::Valu(v) if v.dpp.is_none())
+                    && !inst.name().contains("lane")
+                    && inst.writes.iter().all(|&(r, _)| matches!(r, Reg::V(_)));
+                if !plain_vector_use || executing_thread(p, st, native, (b, i)) != Some(thread) {
+                    return false;
+                }
+            }
+        }
+    }
+    true
+}
