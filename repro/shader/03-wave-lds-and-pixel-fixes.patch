+/// The common size for shader-visible view heaps on this device.
+pub fn view_heap_size(device: &ID3D12Device) -> super::ViewHeapSize {
+    use super::ViewHeapSize;
+    let mut options = D3D12_FEATURE_DATA_D3D12_OPTIONS19::default();
+    // SAFETY: a live device and the feature structure matching the query.
+    let reported = unsafe {
+        device.CheckFeatureSupport(
+            D3D12_FEATURE_D3D12_OPTIONS19,
+            (&raw mut options).cast(),
+            std::mem::size_of_val(&options) as u32,
+        )
+    };
+    let extended = if reported.is_ok() && options.MaxViewDescriptorHeapSize != 0 {
+        options.MaxViewDescriptorHeapSize >= ViewHeapSize::Extended.slots()
+    } else {
+        // Older runtimes do not report the limit. Probe the extended size once.
+        let desc = D3D12_DESCRIPTOR_HEAP_DESC {
+            Type: D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV,
+            NumDescriptors: ViewHeapSize::Extended.slots(),
+            Flags: D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE,
+            NodeMask: 0,
+        };
+        // SAFETY: plain heap creation on this device.
+        unsafe { device.CreateDescriptorHeap::<ID3D12DescriptorHeap>(&desc) }.is_ok()
+    };
+    if extended { ViewHeapSize::Extended } else { ViewHeapSize::Portable }
+}
