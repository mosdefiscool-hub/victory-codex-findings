new file mode 100644
index 0000000000000000000000000000000000000000..b24f4d5200664fe8f6c2dc00a95f205f9abd16b6
--- /dev/null
+++ b/crates/victory-shader/src/emit/lds_order.rs
@@ -0,0 +1,195 @@
+//! Check that splitting a console wave cannot reorder conflicting LDS accesses.
+//! Between two group barriers we accept either a single group thread accessing
+//! arbitrary addresses, or dwords owned by thread x at index x + N * group_size.
+
+use std::collections::{HashMap, HashSet};
+
+use crate::gfx10::{Fields, Operand};
+use crate::ir::{Exit, Inst, Program, Reg, Value};
+use crate::native::{NativeProgram, StageIo};
+use crate::resource::Site;
+use crate::structure::Structured;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Owner {
+    Single(u32),
+    ByThread,
+}
+
+fn private_dwords(inst: &Inst, bases: &HashSet<Value>, threads: u32, bytes: u32) -> bool {
+    let Fields::Ds {
+        addr: Some(Operand::Vector { reg, .. }),
+        offset0,
+        offset1,
+        gds: false,
+        ..
+    } = inst.fields
+    else {
+        return false;
+    };
+    if !inst.read(Reg::V(reg)).is_some_and(|v| bases.contains(&v)) {
+        return false;
+    }
+    let plane = threads * 4;
+    let valid = |offset: u32| offset.is_multiple_of(plane) && offset + plane <= bytes;
+    let a = u32::from(offset0);
+    let b = u32::from(offset1);
+    match inst.name() {
+        "ds_read_b32" | "ds_write_b32" => valid(a | b << 8),
+        "ds_read2_b32" | "ds_write2_b32" => valid(a * 4) && valid(b * 4),
+        "ds_read2st64_b32" | "ds_write2st64_b32" => valid(a * 256) && valid(b * 256),
+        _ => false,
+    }
+}
+
+pub(super) fn independent_phases(p: &Program, st: &Structured, native: &NativeProgram) -> bool {
+    let StageIo::Cs(cs) = &native.io else {
+        return false;
+    };
+    let [threads, 1, 1] = cs.threads else {
+        return false;
+    };
+    if !(1..=1024).contains(&threads) {
+        return false;
+    }
+    let Some(&(_, tid)) = p.inputs.iter().find(|(r, _)| *r == Reg::V(0)) else {
+        return false;
+    };
+    let mut bases = HashSet::new();
+    let mut owners = HashMap::new();
+    for (b, block) in p.blocks.iter().enumerate() {
+        for (i, inst) in block.insts.iter().enumerate() {
+            // Only unconditionally defined SSA values carry the address proof.
+            if let Fields::Valu(v) = &inst.fields
+                && inst.name() == "v_lshlrev_b32"
+                && let [Operand::Const(130), Operand::Vector { reg, dwords: 1 }] = v.src[..]
+                && inst.read(Reg::V(reg)) == Some(tid)
+                && st.guards[b][i].is_none()
+                && v.sdwa.is_none()
+                && v.dpp.is_none()
+                && v.neg == 0
+                && v.abs == 0
+                && v.opsel == 0
+                && !v.clamp
+                && v.omod == 0
+                && let Some(Operand::Vector { reg: dst, .. }) = v.dst
+                && let Some(value) = inst.write(Reg::V(dst))
+            {
+                bases.insert(value);
+            }
+        }
+    }
+    for (b, block) in p.blocks.iter().enumerate() {
+        for (i, inst) in block.insts.iter().enumerate() {
+            let site = (b, i);
+            match &inst.fields {
+                Fields::Ds { gds: false, .. } => {
+                    let owner = if private_dwords(inst, &bases, threads, cs.lds_bytes()) {
+                        Owner::ByThread
+                    } else if (inst.name().starts_with("ds_read")
+                        || inst.name().starts_with("ds_write"))
+                        && let Some(t) = super::singleton::executing_thread(p, st, native, site)
+                    {
+                        Owner::Single(t)
+                    } else {
+                        return false;
+                    };
+                    owners.insert(site, owner);
+                }
+                Fields::Ds { .. } | Fields::Buffer { lds: true, .. } => return false,
+                Fields::Valu(v) if v.src.contains(&Operand::Const(254)) => return false,
+                _ => {}
+            }
+        }
+    }
+    // Walk all paths in a phase, including backedges. Every path which leaves
+    // that phase must meet the same barrier or terminate together. Branches
+    // within the phase can then neither skip nor mismatch a group rendezvous.
+    let mut start = (0, 0);
+    let mut phases = HashSet::new();
+    while phases.insert(start) {
+        let mut queue = vec![start];
+        let mut visited = HashSet::new();
+        let mut boundary: Option<Option<Site>> = None;
+        let mut owner = None;
+        while let Some((b, first)) = queue.pop() {
+            if !visited.insert((b, first)) {
+                continue;
+            }
+            let block = &p.blocks[b];
+            let barrier =
+                (first..block.insts.len()).find(|&i| block.insts[i].name() == "s_barrier");
+            for i in first..barrier.unwrap_or(block.insts.len()) {
+                if let Some(&next) = owners.get(&(b, i))
+                    && owner.replace(next).is_some_and(|prev| prev != next)
+                {
+                    return false;
+                }
+            }
+            let exit = if let Some(i) = barrier {
+                Some((b, i + 1))
+            } else {
+                match block.exit {
+                    Exit::End => None,
+                    Exit::Indirect => return false,
+                    _ => {
+                        queue.extend(block.exit.successors().into_iter().map(|next| (next, 0)));
+                        continue;
+                    }
+                }
+            };
+            if boundary.replace(exit).is_some_and(|prev| prev != exit) {
+                return false;
+            }
+        }
+        match boundary {
+            Some(Some(next)) => start = next,
+            Some(None) => return true,
+            None => return false,
+        }
+    }
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn accepts(words: &[u32]) -> bool {
+        let mut cs = super::super::tests::compute(words, true);
+        cs.io = StageIo::Cs(crate::native::ComputeIo {
+            threads: [256, 1, 1],
+            rsrc2: 16 << 15,
+        });
+        let p = crate::ir::build(&cs.code, true, 32).unwrap();
+        independent_phases(&p, &crate::structure::structure(&p).unwrap(), &cs)
+    }
+
+    #[test]
+    fn interleaved_lds_requires_distinct_thread_ownership() {
+        let mut body = [
+            0x3408_0082, // v_lshlrev_b32 v4, 2, v0
+            0xd834_0000,
+            0x0000_0104, // ds_write_b32 v4, v1
+            0xd8d8_0400,
+            0x0400_0004, // ds_read_b32 v4, v4 offset:1024
+            0xbf81_0000,
+        ];
+        assert!(accepts(&body));
+        body[3] = 0xd8d8_0004; // alias the adjacent lane's address
+        assert!(!accepts(&body));
+        body[3] = 0xd8d8_2000; // beyond the allocation
+        assert!(!accepts(&body));
+    }
+
+    #[test]
+    fn divergent_path_cannot_skip_a_group_barrier() {
+        assert!(!accepts(&[
+            0x7d84_0080, // v_cmp_eq_u32 vcc, 0, v0
+            0xbe80_246a, // s_and_saveexec_b64 s[0:1], vcc
+            0xbf88_0001, // s_cbranch_execz end
+            0xbf8a_0000, // s_barrier
+            0xbf81_0000,
+        ]));
+    }
+}
