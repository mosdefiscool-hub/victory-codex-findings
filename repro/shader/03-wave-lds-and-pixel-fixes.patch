+impl Program {
+    /// A saveexec/wrexec instruction sets SCC iff its new EXEC is nonempty.
+    /// When the branch tests that same EXEC, a single incoming edge fixes
+    /// the value of that SSA condition throughout the successor.
+    pub(crate) fn scc_after_exec_branch(&self, block: usize, scc: Value) -> Option<bool> {
+        let [pred] = self.blocks[block].preds.as_slice() else { return None };
+        let pred = &self.blocks[*pred];
+        let Exit::Branch { taken, not_taken } = pred.exit else { return None };
+        let [.., op, branch] = pred.insts.as_slice() else { return None };
+        let nonempty = match branch.name() {
+            "s_cbranch_execnz" => taken == block,
+            "s_cbranch_execz" => not_taken == block,
+            _ => return None,
+        };
+        let name = op.name();
+        let width = if self.wave64 { "_b64" } else { "_b32" };
+        if taken == not_taken || op.write(Reg::Scc) != Some(scc)
+            || !name.ends_with(width) || !(name.contains("saveexec") || name.contains("wrexec"))
+        {
+            return None;
+        }
+        let words = if self.wave64 { 2 } else { 1 };
+        (0..words).all(|i| {
+            let reg = Reg::S(EXEC + i);
+            op.write(reg).is_some() && op.write(reg) == branch.read(reg)
+        }).then_some(nonempty)
+    }
+}
