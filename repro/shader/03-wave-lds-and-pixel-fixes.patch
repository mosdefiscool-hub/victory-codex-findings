+//! Group-uniform register values used to elide first-lane reads.
+
+use std::collections::{HashMap, HashSet};
+
+use crate::gfx10::{Fields, NULL, Operand};
+use crate::ir::{self, Inst, Program, Reg, Value};
+use crate::native::{NativeProgram, ResourceType, RootType};
+use crate::resource::{Address, Resources, Role, Site, Source, inline};
+use crate::structure::{Bool, Structured};
+
+/// The first-lane reads whose VGPR has the same value in every group lane.
+/// A VGPR write needs full EXEC. A guard elided using block reachability can
+/// still leave other lanes holding the old register value.
+pub(super) fn first_lane_reads(
+    p: &Program,
+    st: &Structured,
+    native: &NativeProgram,
+    res: &Resources,
+) -> HashSet<Value> {
+    let params: HashSet<Value> = res
+        .params
+        .iter()
+        .filter(|&&(_, param, _)| native.layout[param].root == RootType::Constants)
+        .map(|&(value, _, _)| value)
+        .collect();
+    let mut uniform: HashSet<Value> = p
+        .inputs
+        .iter()
+        .map(|&(_, value)| value)
+        .filter(|value| params.contains(value))
+        .collect();
+    let scalar: HashMap<Site, Address> = res.scalar.iter().copied().collect();
+    let descriptors: HashMap<Site, &Source> = res
+        .descriptors
+        .iter()
+        .filter(|d| d.role == Role::Resource)
+        .map(|d| (d.site, &d.source))
+        .collect();
+    let mut reads = HashSet::new();
+    // An SSA definition dominates its use and therefore comes first in
+    // reverse postorder. A phi can pick different values and is left unproven.
+    for b in ir::reverse_postorder(&p.blocks) {
+        for (i, inst) in p.blocks[b].insts.iter().enumerate() {
+            let name = inst.name();
+            let op_uniform = |op| uniform_operand(&uniform, inst, op);
+            match &inst.fields {
+                Fields::Valu(v)
+                    if v.dpp.is_none() && v.sdwa.is_none() && v.opsel == 0 && v.opsel_hi == 0 =>
+                {
+                    if name == "v_readfirstlane_b32"
+                        && let [op @ Operand::Vector { dwords: 1, .. }] = v.src.as_slice()
+                        && op_uniform(op)
+                        && let Some(Operand::Scalar {
+                            code: code @ 0..=105,
+                            dwords: 1,
+                        }) = v.dst
+                        && let Some(value) = inst.write(Reg::S(code))
+                    {
+                        // Even with empty EXEC the selected value (lane 0)
+                        // equals the caller's value.
+                        reads.insert(value);
+                        uniform.insert(value);
+                    } else if st.execs[b][i] == Some(Bool::TRUE)
+                        && pure_valu(name)
+                        && v.src.iter().all(op_uniform)
+                        && let Some(Operand::Vector { reg, dwords: 1 }) = v.dst
+                    {
+                        uniform.extend(inst.write(Reg::V(reg)));
+                    }
+                }
+                Fields::Sop {
+                    dst:
+                        Some(Operand::Scalar {
+                            code: code @ 0..=105,
+                            dwords: 1,
+                        }),
+                    src,
+                    ..
+                } if name == "s_movk_i32" || pure_salu(name) && src.iter().all(op_uniform) => {
+                    uniform.extend(inst.write(Reg::S(*code)));
+                }
+                Fields::Smem { soffset, .. }
+                    if name.starts_with("s_buffer_load_dword")
+                        && op_uniform(soffset)
+                        && descriptors
+                            .get(&(b, i))
+                            .is_some_and(|src| immutable_cbv(native, &scalar, &uniform, src)) =>
+                {
+                    uniform.extend(inst.writes.iter().map(|&(_, value)| value));
+                }
+                _ => {}
+            }
+        }
+    }
+    reads
+}
+
+fn uniform_operand(uniform: &HashSet<Value>, inst: &Inst, op: &Operand) -> bool {
+    let reg = match *op {
+        Operand::Literal(_)
+        | Operand::Scalar {
+            code: NULL,
+            dwords: 1,
+        } => return true,
+        Operand::Const(code) => return inline(code).is_some(),
+        Operand::Scalar {
+            code: code @ 0..=105,
+            dwords: 1,
+        } => Reg::S(code),
+        Operand::Vector { reg, dwords: 1 } => Reg::V(reg),
+        _ => return false,
+    };
+    inst.read(reg).is_some_and(|v| uniform.contains(&v))
+}
+
+/// Require a statically identified CBV and a group-uniform address within it.
+/// Dynamic heap bindings, descriptor choices and other memory can differ
+/// between lanes or expose writes made by other work in the dispatch.
+fn immutable_cbv(
+    native: &NativeProgram,
+    scalar: &HashMap<Site, Address>,
+    uniform: &HashSet<Value>,
+    src: &Source,
+) -> bool {
+    let (address, root, first) = match src {
+        Source::Loaded { load, first } => {
+            let Some(address) = scalar.get(load).filter(|a| a.dynamic.is_none()) else {
+                return false;
+            };
+            (*address, RootType::Table, u32::from(*first))
+        }
+        Source::Built { address, .. } if address.dynamic.is_none_or(|v| uniform.contains(&v)) => {
+            (*address, RootType::Descriptor, 0)
+        }
+        _ => return false,
+    };
+    let Some(param) = native.layout.get(address.param).filter(|p| p.root == root) else {
+        return false;
+    };
+    native.used.iter().any(|u| {
+        u.kind == ResourceType::Cbv
+            && u.root == root
+            && u.user_data == param.user_data
+            && u.slot == param.slot
+            && (root == RootType::Descriptor
+                || address.offset.is_multiple_of(4)
+                    && u.table_offset_dwords == address.offset / 4 + first)
+    })
+}
+
+// Keep the allowlists to dword operations with no hidden input such as
+// a carry flag or a lane mask.
+fn pure_salu(name: &str) -> bool {
+    matches!(
+        name,
+        "s_mov_b32"
+            | "s_add_u32"
+            | "s_add_i32"
+            | "s_sub_u32"
+            | "s_sub_i32"
+            | "s_mul_i32"
+            | "s_and_b32"
+            | "s_or_b32"
+            | "s_xor_b32"
+            | "s_lshl_b32"
+            | "s_lshr_b32"
+            | "s_ashr_i32"
+    )
+}
+
+fn pure_valu(name: &str) -> bool {
+    matches!(
+        name,
+        "v_mov_b32"
+            | "v_add_nc_u32"
+            | "v_sub_nc_u32"
+            | "v_subrev_nc_u32"
+            | "v_min_u32"
+            | "v_max_u32"
+            | "v_and_b32"
+            | "v_or_b32"
+            | "v_xor_b32"
+            | "v_lshlrev_b32"
+            | "v_lshrrev_b32"
+            | "v_ashrrev_i32"
+            | "v_add_f32"
+            | "v_sub_f32"
+            | "v_subrev_f32"
+            | "v_mul_f32"
+            | "v_mul_legacy_f32"
+            | "v_exp_f32"
+            | "v_rndne_f32"
+            | "v_cvt_u32_f32"
+            | "v_cvt_f32_u32"
+    )
+}
