+#[test]
+fn title_memory_waits_publish_payloads_across_groups() {
+    const GROUPS: u32 = 16;
+    const PAYLOAD_SHIFT: u32 = 6;
+    const PAYLOAD_STRIDE: u32 = 1 << PAYLOAD_SHIFT;
+    const PAYLOAD_TAG: u32 = 0xC0DE_1000;
+    const COUNTER_PAGE: u64 = TITLE + 0x1_0000;
+    const RESULT_OFFSET: u32 = 16;
+    const SENTINEL: u32 = 0xDEAD_BEEF;
+    const DRAINED_WAITS: [u32; 2] = [0xBF8C_0070, 0xBBFD_0000];
+
+    // s[0:1] and s[2:3] point to different title-memory pages. Each group
+    // writes one dword at its own 64-byte offset, then increments the shared counter.
+    let mut words = vec![
+        v_mov_b32(0, ZERO),
+        v_mov_b32(1, 4),             // s4: group ID X
+        0x3404_0280 | PAYLOAD_SHIFT, // v_lshlrev_b32 v2, PAYLOAD_SHIFT, v1
+        sop2(0x10, 5, 4, 255),
+        PAYLOAD_TAG, // s_or_b32 s5, s4, PAYLOAD_TAG
+        v_mov_b32(3, 5),
+    ];
+    let mut store = global(28, 0, 2, 3, 0, 0);
+    store[0] |= 1 << 16; // glc
+    words.extend(store);
+    words.extend(DRAINED_WAITS);
+    words.push(v_mov_b32(3, ZERO + 1));
+    let mut atomic = global(0x32, 4, 0, 3, 2, 0);
+    atomic[0] |= 1 << 16; // glc, return the old counter in v4
+    words.extend(atomic);
+    words.extend([
+        S_WAITCNT_ALL,
+        0x7E0A_0504,                                       // v_readfirstlane_b32 s5, v4
+        0xBF06_0005 | (u32::from(ZERO) + GROUPS - 1) << 8, // s_cmp_eq_u32 s5, GROUPS - 1
+    ]);
+    let branch = words.len();
+    words.push(0);
+    // Only the last arrival reads the payloads. It acquires memory before
+    // reading and records what it saw on the counter page.
+    words.extend(DRAINED_WAITS);
+    for group in 0..GROUPS {
+        let mut load = global(12, 5, 0, 0, 0, group * PAYLOAD_STRIDE);
+        load[0] |= 1 << 16 | 1 << 12; // glc dlc
+        words.extend(load);
+        words.push(S_WAITCNT_ALL);
+        words.extend(global(28, 0, 0, 5, 2, RESULT_OFFSET + 4 * group));
+    }
+    words[branch] = 0xBF84_0000 | (words.len() - branch - 1) as u32; // s_cbranch_scc0 -> end
+    words.push(S_ENDPGM);
+
+    let mut native = super::tests::compute_of(&words, false, 1);
+    native.layout.push(RootParam {
+        root: RootType::Constants,
+        table_offset_dwords: 0,
+        sgprs: 4,
+        base_register: 0,
+        user_data: 0,
+        slot: 0,
+    });
+    native.io = StageIo::Cs(ComputeIo {
+        rsrc2: 4 << 1 | 1 << 7,
+        threads: [1, 1, 1],
+    });
+
+    let _one = super::valu_tests::ONE_AT_A_TIME
+        .lock()
+        .unwrap_or_else(|e| e.into_inner());
+    let payload_words = (GROUPS * PAYLOAD_STRIDE / 4) as usize;
+    let result_start = (RESULT_OFFSET / 4) as usize;
+    let payloads = vec![SENTINEL; payload_words];
+    let mut counter = vec![SENTINEL; result_start + GROUPS as usize];
+    counter[0] = 0;
+    let mut expected_payloads = payloads.clone();
+    let mut expected_counter = counter.clone();
+    expected_counter[0] = GROUPS;
+    for group in 0..GROUPS {
+        let value = PAYLOAD_TAG | group;
+        expected_payloads[(group * PAYLOAD_STRIDE / 4) as usize] = value;
+        expected_counter[result_start + group as usize] = value;
+    }
+
+    let mut pages = page_table(0, 4);
+    let payload_entry = 4096 + ((TITLE >> 16) & 0xFFF) as usize;
+    let counter_entry = payload_entry + 1;
+    let mapping = 4096 + 2 * counter_entry;
+    pages[mapping..mapping + 2].copy_from_slice(&[2, COUNTER_PAGE as u32]);
+    let pointer_words = [
+        TITLE as u32,
+        (TITLE >> 32) as u32,
+        COUNTER_PAGE as u32,
+        (COUNTER_PAGE >> 32) as u32,
+    ];
+    let mut ran = 0;
+    for (label, warp) in [("hardware", false), ("warp", true)] {
+        let Ok(host) = Host::new(warp) else {
+            eprintln!("no SM 6.6 {label} device; skipped");
+            continue;
+        };
+        let shader = super::tests::emit_for(&native, host.target()).expect("lower");
+        assert!(shader.memory && shader.memory_writes && shader.root_uavs.is_empty());
+        assert!(!shader.view_addresses && !shader.view_marks);
+        if let Ok(mut v) =
+            validator::Validator::load(validator::Validator::default_path().as_deref())
+        {
+            v.validate(&mut shader.dxil.clone())
+                .expect("DXIL validation failed");
+        }
+        let mut ud = vec![0u32; shader.user_data_dwords() as usize];
+        for u in &shader.user_data {
+            assert_eq!(u.root, RootType::Constants);
+            ud[u.index as usize] = pointer_words[u.dword as usize];
+        }
+        assert_eq!(ud, pointer_words, "{label}: title pointer mapping");
+        let (root, pso) = host.compute_pipeline(&shader).expect("pipeline");
+        let out = host
+            .dispatch(
+                &root,
+                &pso,
+                &Dispatch {
+                    roots: vec![
+                        (0, Root::Constants(ud)),
+                        (
+                            1,
+                            Root::View {
+                                srv: true,
+                                data: pages.clone(),
+                            },
+                        ),
+                        (2, Root::Uav(2 * 4096 / 32)),
+                    ],
+                    views: &[
+                        View::Memory(&payloads),
+                        View::Pair,
+                        View::Memory(&counter),
+                        View::Pair,
+                        View::NullPair,
+                        View::Pair,
+                    ],
+                    samplers: &[],
+                    groups: [GROUPS, 1, 1],
+                },
+            )
+            .unwrap_or_else(|e| panic!("{label}: {e}"));
+        assert_eq!(
+            out[0], expected_payloads,
+            "{label}: individual published payloads"
+        );
+        assert_eq!(
+            out[1], expected_counter,
+            "{label}: count and last group's reads"
+        );
+        let marked: Vec<usize> = (0..out[2].len() * 32)
+            .filter(|&bit| out[2][bit / 32] >> (bit % 32) & 1 != 0)
+            .collect();
+        assert_eq!(
+            marked,
+            [payload_entry, counter_entry],
+            "{label}: two written pages"
+        );
+        ran += 1;
+    }
+    assert!(ran > 0, "neither hardware nor WARP SM 6.6 device available");
+}
