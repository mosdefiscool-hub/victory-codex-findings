+
+/// The outer loop enters at FF1 and clears the lowest set bit on its
+/// backedge. Each bit selects a signed unit-stride range in the inner loop.
+#[test]
+fn nested_bit_scan_and_counted_console_wave_loops_preserve_values() {
+    let body = [
+        0xD760_0009, 0x0001_5100, // v_readlane_b32 s9, v0, 40
+        0x8809_FF09, 0x8000_0000, // s_or_b32 s9, s9, 0x80000000
+        0xBE95_0380, // s_mov_b32 s21, 0 (range hash)
+        0xBE96_0380, // s_mov_b32 s22, 0 (visited bits)
+        0xBE8E_03BF, // s_mov_b32 s14, 63 (range cap)
+        0xBE8F_0382, // s_mov_b32 s15, 2 (range width)
+        0xBF06_8009, // s_cmp_eq_u32 s9, 0
+        0xBF85_0013, // s_cbranch_scc1 done
+        0xBE8A_0309, // s_mov_b32 s10, s9
+        0xBF82_0001, // s_branch scan
+        // clear:
+        0x890A_0A10, // s_xor_b32 s10, s16, s10
+        // scan:
+        0xBE8B_130A, // s_ff1_i32_b32 s11, s10
+        0x930C_0F0B, // s_mul_i32 s12, s11, s15
+        0x8110_0F0C, // s_add_i32 s16, s12, s15
+        0x838D_0E10, // s_min_u32 s13, s16, s14
+        0xBF03_0D0C, // s_cmp_ge_i32 s12, s13
+        0xBF85_000A, // s_cbranch_scc1 done
+        // count:
+        0x9315_8315, // s_mul_i32 s21, s21, 3
+        0x8015_0C15, // s_add_u32 s21, s21, s12
+        0x810C_810C, // s_add_i32 s12, s12, 1
+        0xBF03_0D0C, // s_cmp_ge_i32 s12, s13
+        0xBF84_FFFB, // s_cbranch_scc0 count
+        0xBE96_1D0B, // s_bitset1_b32 s22, s11
+        0x8710_9F0B, // s_and_b32 s16, s11, 31
+        0x8F10_1081, // s_lshl_b32 s16, 1, s16
+        0xBF06_100A, // s_cmp_eq_u32 s10, s16
+        0xBF84_FFEF, // s_cbranch_scc0 clear
+        // done: even lanes store the range hash, odd lanes store the visited bits.
+        0x3606_0081, // v_and_b32 v3, 1, v0
+        0x7D84_0680, // v_cmp_eq_u32 vcc, 0, v3
+        0x7E02_0216, // v_mov_b32 v1, s22
+        0x7E04_0215, // v_mov_b32 v2, s21
+        0xD501_0002, 0x01AA_0501, // v_cndmask_b32 v2, v1, v2, vcc
+    ];
+    let target = super::Target { lanes_min: 32, lanes_max: 32 };
+    let p = program(&body, 128);
+    assert_eq!(emit_for(&p, target).unwrap().group_waves, 2);
+    for (index, replacement, label) in [
+        (26, 0x8F10_1082, "clear a different bit"),
+        (21, 0x810C_800C, "leave the counter unchanged"),
+        (20, 0x810D_830C, "advance the bound with the counter"),
+    ] {
+        let mut bad = body;
+        bad[index] = replacement;
+        assert!(emit_for(&program(&bad, 128), target).is_err(), "{label}");
+    }
+    program_case(
+        "nested scalar bit scan and counted loops",
+        &p,
+        |t| {
+            let bits = 0x8000_0000 | ((t & !63) + 40);
+            if t % 2 == 1 {
+                return bits;
+            }
+            (0..32)
+                .filter(|bit| bits & (1 << bit) != 0)
+                .flat_map(|bit| 2 * bit..(2 * bit + 2).min(63))
+                .fold(0u32, |hash, i| hash.wrapping_mul(3).wrapping_add(i))
+        },
+        true,
+    );
+}
