index 0000000000000000000000000000000000000000..44222324c09f6eb313800c2531faba840a24ed23
--- /dev/null
+++ b/crates/victory-shader/src/emit/lower/loops.rs
@@ -0,0 +1,176 @@
+//! Termination proofs for guest loops when scheduling logical waves serially.
+use crate::gfx10::{Fields, Operand};
+use crate::ir::{Exit, Inst, Program, Reg, Value};
+
+fn sources<const N: usize>(i: &Inst) -> Option<[Operand; N]> {
+    let Fields::Sop { src, .. } = &i.fields else {
+        return None;
+    };
+    src.as_slice().try_into().ok()
+}
+
+fn value(i: &Inst, op: Operand) -> Option<Value> {
+    match op {
+        Operand::Scalar { code, dwords: 1 } => i.read(Reg::S(code)),
+        _ => None,
+    }
+}
+
+fn immediate(op: Operand) -> Option<u32> {
+    match op {
+        Operand::Const(n @ 128..=192) => Some(u32::from(n - 128)),
+        _ => None,
+    }
+}
+
+fn result(i: &Inst) -> Option<Value> {
+    let Fields::Sop {
+        dst: Some(Operand::Scalar { code, dwords: 1 }),
+        ..
+    } = i.fields
+    else {
+        return None;
+    };
+    i.write(Reg::S(code))
+}
+
+pub(super) fn finite(p: &Program, header: usize, latch: usize) -> bool {
+    let end = &p.blocks[latch];
+    let Exit::Branch { taken, not_taken } = end.exit else {
+        return false;
+    };
+    let [.., cmp, branch] = end.insts.as_slice() else {
+        return false;
+    };
+    header != 0
+        && taken == header
+        && not_taken > latch
+        && branch.name() == "s_cbranch_scc0"
+        && cmp.write(Reg::Scc).is_some()
+        && cmp.write(Reg::Scc) == branch.read(Reg::Scc)
+        && (counted(p, header, latch, cmp).is_some()
+            || clear_low_bit(p, header, latch, cmp).is_some())
+}
+
+/// A finite scalar induction loop cannot wait for another wave to make
+/// progress. Follow the compared SSA value back through immediate additions
+/// to the header phi, including when the compiler renames the counter.
+fn counted(p: &Program, header: usize, latch: usize, cmp: &Inst) -> Option<()> {
+    let head = &p.blocks[header];
+    if head.preds.len() != 2 || !matches!(cmp.name(), "s_cmp_eq_u32" | "s_cmp_ge_i32") {
+        return None;
+    }
+    // Single entry. All paths inside the body run forward up to the latch.
+    for b in header + 1..=latch {
+        if p.blocks[b]
+            .preds
+            .iter()
+            .any(|&pred| pred < header || pred >= b)
+        {
+            return None;
+        }
+    }
+    let incoming = head.preds.iter().position(|&b| b < header)?;
+    if head.preds[1 - incoming] != latch {
+        return None;
+    }
+    let [reg, limit] = sources(cmp)?;
+    let next = value(cmp, reg)?;
+    let mut current = next;
+    let mut step = 0u32;
+    for block in p.blocks[header..=latch].iter().rev() {
+        for i in block.insts.iter().rev() {
+            if !i.writes.iter().any(|&(_, v)| v == current) {
+                continue;
+            }
+            if i.name() != "s_add_i32" && i.name() != "s_add_u32" {
+                return None;
+            }
+            let [reg, delta] = sources(i)?;
+            current = value(i, reg)?;
+            step = step.checked_add(immediate(delta)?)?;
+        }
+    }
+    let phi = head.phis.iter().find(|phi| phi.value == current)?;
+    if phi.args[1 - incoming] != next || step == 0 {
+        return None;
+    }
+    if cmp.name() == "s_cmp_ge_i32" {
+        // Unit increments visit every i32, so must eventually reach a
+        // fixed signed upper bound. A bound defined inside the loop can
+        // move along with the counter or be polled from shared memory.
+        let bound = value(cmp, limit)?;
+        let defined_inside = p.blocks[header..=latch].iter().any(|b| {
+            b.phis.iter().any(|phi| phi.value == bound)
+                || b.insts
+                    .iter()
+                    .any(|i| i.writes.iter().any(|&(_, v)| v == bound))
+        });
+        return (step == 1 && !defined_inside).then_some(());
+    }
+    let limit = immediate(limit)?;
+    let init = p.blocks[head.preds[incoming]]
+        .insts
+        .iter()
+        .find(|i| i.name() == "s_mov_b32" && i.write(phi.reg) == Some(phi.args[incoming]))?;
+    let [start] = sources(init)?;
+    let distance = limit.checked_sub(immediate(start)?)?;
+    (distance > 0 && distance.is_multiple_of(step)).then_some(())
+}
+
+/// On the taken edge, XOR removes the lowest set bit of the compared
+/// mask. A single bit exits before XOR, and even an initial zero becomes
+/// a single bit on the first iteration. Inner loops are checked separately.
+fn clear_low_bit(p: &Program, header: usize, latch: usize, cmp: &Inst) -> Option<()> {
+    let update = &p.blocks[header];
+    let Exit::Jump(join) = update.exit else {
+        return None;
+    };
+    if join != header + 1 || join > latch || update.preds != [latch] || cmp.name() != "s_cmp_eq_u32"
+    {
+        return None;
+    }
+    let body = &p.blocks[join];
+    let back = body.preds.iter().position(|&b| b == header)?;
+    if body.preds.len() != 2 || body.preds[1 - back] >= header {
+        return None;
+    }
+    if (join + 1..=latch).any(|b| {
+        p.blocks[b]
+            .preds
+            .iter()
+            .any(|&pred| pred < join || pred > latch)
+    }) {
+        return None;
+    }
+    let [mask_reg, bit_reg] = sources(cmp)?;
+    let mask = value(cmp, mask_reg)?;
+    let bit = value(cmp, bit_reg)?;
+    let phi = body.phis.iter().find(|phi| phi.value == mask)?;
+    let xor = update
+        .insts
+        .iter()
+        .find(|i| result(i) == Some(phi.args[back]))?;
+    let [bit_arg, mask_arg] = sources(xor)?;
+    if xor.name() != "s_xor_b32" || value(xor, bit_arg)? != bit || value(xor, mask_arg)? != mask {
+        return None;
+    }
+    let [.., and, shift, _, _] = p.blocks[latch].insts.as_slice() else {
+        return None;
+    };
+    let [one, count] = sources(shift)?;
+    let [idx, low_five] = sources(and)?;
+    if shift.name() != "s_lshl_b32"
+        || result(shift)? != bit
+        || immediate(one)? != 1
+        || and.name() != "s_and_b32"
+        || immediate(low_five)? != 31
+        || result(and)? != value(shift, count)?
+    {
+        return None;
+    }
+    let index = value(and, idx)?;
+    let first = body.insts.iter().find(|i| result(i) == Some(index))?;
+    let [source] = sources(first)?;
+    (first.name() == "s_ff1_i32_b32" && value(first, source)? == mask).then_some(())
+}
